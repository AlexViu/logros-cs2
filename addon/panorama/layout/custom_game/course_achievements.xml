<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/course_achievements.css" />
	</styles>

	<!--
		HUD Panorama de logros (CourseAchievements). Misma técnica que RandomPicksHud: la entidad custom_hud_layout la crea el
		plugin y rellena cada Label por su variable de diálogo (mismo nombre que el id). Las etiquetas solo admiten texto plano.
		El plugin conmuta por jugador las clases: show (aviso), hidden (paneles y filas), left (seguimiento), done (filas) y
		w0..w10 (relleno de las barras). El panel raíz no puede llevar id.
		Con RandomPicksHud el plugin solo usa el aviso: la lista va en sus menús y el seguimiento no se muestra.
	-->
	<Panel class="CaHud" hittest="false">

		<!-- Centrado, algo por encima del medio: copa + nombre del logro y una barra que se vacía mientras se ve -->
		<Panel id="ca_toast" class="CaToast" hittest="false">
			<Panel class="CaToastRow" hittest="false">
				<Image class="CaTrophy" src="s2r://panorama/images/icons/ui/trophy.vsvg" textureheight="64" hittest="false" />
				<Label id="ca_toast_name" class="CaToastName" hittest="false" text="{s:ca_toast_name}" />
			</Panel>
			<Panel class="CaToastBarBg" hittest="false">
				<Panel class="CaToastBar" hittest="false" />
			</Panel>
		</Panel>

		<!-- Lateral: logros conseguidos, puntos y el siguiente logro con su progreso -->
		<Panel id="ca_tracker" class="CaTracker hidden" hittest="false">
			<Panel class="CaRow" hittest="false">
				<Label id="ca_trk_title" class="CaSection" hittest="false" text="{s:ca_trk_title}" />
				<Label id="ca_trk_count" class="CaVal CaCount" hittest="false" text="{s:ca_trk_count}" />
				<Label id="ca_trk_score" class="CaVal CaGold CaScore" hittest="false" text="{s:ca_trk_score}" />
			</Panel>
			<Label id="ca_trk_next_label" class="CaLbl CaNextLbl" hittest="false" text="{s:ca_trk_next_label}" />
			<Label id="ca_trk_next" class="CaVal CaNextName" hittest="false" text="{s:ca_trk_next}" />
			<Panel class="CaRow CaBarRow" hittest="false">
				<Panel class="CaBarBg CaTrackerBar" hittest="false">
					<Panel id="ca_trk_bar" class="CaBarFill w0" hittest="false" />
				</Panel>
				<Label id="ca_trk_prog" class="CaLbl CaProg" hittest="false" text="{s:ca_trk_prog}" />
			</Panel>
		</Panel>

		<!-- Centro: lista de logros por páginas (!logros) -->
		<Panel id="ca_list" class="CaList hidden" hittest="false">
			<Panel class="CaRow CaListHead" hittest="false">
				<Label id="ca_list_title" class="CaTitle" hittest="false" text="{s:ca_list_title}" />
				<Label id="ca_list_sub" class="CaSub CaRight" hittest="false" text="{s:ca_list_sub}" />
			</Panel>
			<Panel class="CaDivider" hittest="false" />
			<Panel id="ca_row_0" class="CaEntry hidden" hittest="false">
				<Panel class="CaDot" hittest="false" />
				<Panel class="CaEntryText" hittest="false">
					<Label id="ca_row_0_name" class="CaEntryName" hittest="false" text="{s:ca_row_0_name}" />
					<Label id="ca_row_0_desc" class="CaEntryDesc" hittest="false" text="{s:ca_row_0_desc}" />
				</Panel>
				<Panel class="CaEntryProg" hittest="false">
					<Label id="ca_row_0_prog" class="CaLbl" hittest="false" text="{s:ca_row_0_prog}" />
					<Panel class="CaBarBg" hittest="false"><Panel id="ca_row_0_bar" class="CaBarFill w0" hittest="false" /></Panel>
				</Panel>
				<Label id="ca_row_0_pts" class="CaEntryPts" hittest="false" text="{s:ca_row_0_pts}" />
			</Panel>
			<Panel id="ca_row_1" class="CaEntry hidden" hittest="false">
				<Panel class="CaDot" hittest="false" />
				<Panel class="CaEntryText" hittest="false">
					<Label id="ca_row_1_name" class="CaEntryName" hittest="false" text="{s:ca_row_1_name}" />
					<Label id="ca_row_1_desc" class="CaEntryDesc" hittest="false" text="{s:ca_row_1_desc}" />
				</Panel>
				<Panel class="CaEntryProg" hittest="false">
					<Label id="ca_row_1_prog" class="CaLbl" hittest="false" text="{s:ca_row_1_prog}" />
					<Panel class="CaBarBg" hittest="false"><Panel id="ca_row_1_bar" class="CaBarFill w0" hittest="false" /></Panel>
				</Panel>
				<Label id="ca_row_1_pts" class="CaEntryPts" hittest="false" text="{s:ca_row_1_pts}" />
			</Panel>
			<Panel id="ca_row_2" class="CaEntry hidden" hittest="false">

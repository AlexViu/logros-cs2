					<Panel class="CaBarBg" hittest="false"><Panel id="ca_row_6_bar" class="CaBarFill w0" hittest="false" /></Panel>
				</Panel>
				<Label id="ca_row_6_pts" class="CaEntryPts" hittest="false" text="{s:ca_row_6_pts}" />
